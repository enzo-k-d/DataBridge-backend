PORT=11001
FRONTEND_ORIGIN=http://localhost:11000

# Gere uma chave local conforme o README. Não use o placeholder como chave.
JWT_SECRET=SUBSTITUA_PELA_CHAVE_GERADA

# Use o endereço e a porta reais do seu servidor PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=11002
# Este banco e o usuário PostgreSQL precisam existir antes da conexão.
DB_NAME=dataflow
DB_USER=dataflow_app
DB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_USUARIO_POSTGRESQL
